# ==========================================
# Application
# ==========================================
NODE_ENV=
PORT=
APP_NAME=
APP_URL=

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=

# ==========================================
# SENTRY
# ==========================================
SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/YYYYY

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=3600s
JWT_RESET_SECRET=

# ==========================================
# BREVO
# ==========================================
SIB_API_KEY=
# ============================================
# REDIS (internal Docker network)
# ============================================
REDIS_URL=

# ==========================================
# AWS S3
# ==========================================
AWS_REGION=
AWS_S3_BUCKET=
# Only needed for local dev; in production prefer an IAM role and leave these unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: CloudFront/custom domain serving the public objects (avatars, portfolio images).
# Defaults to the bucket's virtual-hosted-style URL when unset.
AWS_S3_PUBLIC_BASE_URL=

# ==========================================
# STRIPE (Connects purchases)
# ==========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Base URL Stripe Checkout redirects back to after payment (success/cancel).
FRONTEND_URL=

# ==========================================
# CONNECTS
# ==========================================
# Free starter connects granted when a TutorProfile is created.
CONNECTS_SIGNUP_GRANT=5