# ==========================================
# Application
# ==========================================
NODE_ENV=
PORT=
APP_NAME=
APP_URL=

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=

# ==========================================
# SENTRY
# ==========================================
SENTRY_DSN=https://your-key@oXXXXX.ingest.sentry.io/YYYYY

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_RESET_SECRET=
# Refresh tokens are signed JWTs whose authoritative validity lives in
# Redis (see RefreshTokenService) — the signature/expiry alone isn't
# enough to pass rotation.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# BREVO
# ==========================================
SIB_API_KEY=
# ============================================
# REDIS (internal Docker network)
# ============================================
REDIS_URL=

# ==========================================
# AWS S3
# ==========================================
AWS_REGION=
AWS_S3_BUCKET=
# Only needed for local dev; in production prefer an IAM role and leave these unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: CloudFront/custom domain serving the public objects (avatars, portfolio images).
# Defaults to the bucket's virtual-hosted-style URL when unset.
AWS_S3_PUBLIC_BASE_URL=

# ==========================================
# DAILY.CO (video sessions)
# ==========================================
DAILY_API_KEY=
# Base64-encoded HMAC-SHA256 secret, supplied when registering the webhook
# (POST /v1/webhooks) -- see README for the one-time manual registration step.
DAILY_WEBHOOK_SECRET=

# ==========================================
# STRIPE
# ==========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used to build Stripe Connect onboarding refresh/return URLs.
FRONTEND_URL=

# ==========================================
# ADMIN SEED (npm run seed:admin)
# ==========================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=