generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

enum UserRole {
  LEARNER
  TUTOR
  ADMIN
}

enum LanguageLevel {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE_OR_BILINGUAL
}

enum PortfolioMediaType {
  IMAGE
  VIDEO_FILE
  VIDEO_LINK
  LINK
}

enum TutorVerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
  REVOKED

  @@map("tutor_verification_status")
}

model User {
  id                           String                       @id @default(uuid())
  email                        String                       @unique
  password                     String                       @map("password")
  unverifiedEmail              String?                      @map("unverified_email")
  firstname                    String                       @map("firstname")
  lastname                     String                       @map("lastname")
  avatar                       String?                      @map("avatar_key")
  headline                     String?
  bio                          String?                      @db.Text
  phone                        String?                      @unique @map("phone")
  phoneCountryCode             String?                      @map("phone_country_code")
  dateOfBirth                  DateTime?                    @map("date_of_birth")
  country                      String?
  address                      String?
  city                         String?
  state                        String?
  postalCode                   String?                      @map("postal_code")
  role                         UserRole                     @default(LEARNER)
  isOnlineForMsg               Boolean                      @default(false) @map("is_online_for_msg")
  onboardingStep               Int                          @default(1) @map("onboarding_step")
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")
  refreshTokens                RefreshToken[]
  tutorProfile                 TutorProfile?                @relation("TutorProfileUser")
  reviewedTutorVerifications   TutorProfile[]               @relation("TutorVerificationReviewer")
  learnerProfile               LearnerProfile?
  education                    Education[]
  languages                    UserLanguage[]
  tutorAvailabilityRules       TutorAvailabilityRule[]      @relation("TutorAvailabilityRules")
  tutorAvailabilityExceptions  TutorAvailabilityException[] @relation("TutorAvailabilityExceptions")
  learnRequests                LearnRequest[]               @relation("LearnerLearnRequests")
  proposals                    Proposal[]                   @relation("TutorProposals")
  savedLearnRequests           SavedLearnRequest[]          @relation("TutorSavedLearnRequests")
  shortlistedProposals         ShortlistedProposal[]        @relation("LearnerShortlistedProposals")
  tutorSlotHolds               SlotHold[]                   @relation("TutorSlotHolds")
  learnerSlotHolds             SlotHold[]                   @relation("LearnerSlotHolds")
  tutorBookings                Booking[]                    @relation("TutorBookings")
  learnerBookings              Booking[]                    @relation("LearnerBookings")
  tutorConversations           Conversation[]               @relation("TutorConversations")
  learnerConversations         Conversation[]               @relation("LearnerConversations")
  sentMessages                 Message[]                    @relation("SentMessages")
  announcementsAuthored        Announcement[]               @relation("AnnouncementAuthor")
  announcementCommentsAuthored AnnouncementComment[]        @relation("AnnouncementCommentAuthor")
  assignmentCommentsAuthored   AssignmentComment[]          @relation("AssignmentCommentAuthor")

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  deviceId   String // identifies a device — one active session per device
  deviceName String? // display label for the sessions list ("iPhone 14")
  revoked    Boolean   @default(false)
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  specialties    Specialty[]
  learnRequests  LearnRequest[]  @relation("CategoryLearnRequests")
  categorySkills CategorySkill[]

  @@index([isActive])
  @@map("categories")
}

model Specialty {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  name       String
  slug       String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  tutorProfiles    TutorProfileSpecialty[]
  learnerInterests LearnerProfileInterest[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@map("specialties")
}

model TutorProfileSpecialty {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  specialtyId String   @map("specialty_id")
  createdAt   DateTime @default(now()) @map("created_at")

  profile   TutorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  specialty Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([profileId, specialtyId])
  @@index([profileId])
  @@index([specialtyId])
  @@map("tutor_profile_specialties")
}

model TutorProfile {
  id            String  @id @default(uuid())
  userId        String  @unique @map("user_id")
  videoIntroUrl String? @map("video_intro_url")

  verificationStatus TutorVerificationStatus @default(UNSUBMITTED) @map("verification_status")
  submittedAt        DateTime?               @map("submitted_at")
  reviewedById       String?                 @map("reviewed_by_id")
  reviewedAt         DateTime?               @map("reviewed_at")
  reviewNote         String?                 @map("review_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User                @relation("TutorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("TutorVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  skills     TutorProfileSkill[]

  portfolio      PortfolioItem[]
  certifications Certification[]
  employment     Employment[]
  specialties    TutorProfileSpecialty[]

  @@index([verificationStatus])
  @@map("tutor_profiles")
}

model UserLanguage {
  id       String        @id @default(uuid())
  userId   String        @map("user_id")
  language String
  level    LanguageLevel

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_languages")
}

model Education {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  institution  String
  degree       String?
  fieldOfStudy String? @map("field_of_study")
  startYear    Int?    @map("start_year")
  endYear      Int?    @map("end_year")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("education")
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tutorProfiles      TutorProfileSkill[]
  portfolioItems     PortfolioItemSkill[]
  learnRequestSkills LearnRequestSkill[]
  categorySkills     CategorySkill[]

  @@index([name])
  @@map("skills")
}

model CategorySkill {
  id         String   @id @default(uuid())
  categoryId String   @map("category_id")
  skillId    String   @map("skill_id")
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([categoryId, skillId])
  @@index([categoryId])
  @@index([skillId])
  @@map("category_skills")
}

model TutorProfileSkill {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  profile TutorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
  @@map("tutor_profile_skills")
}

model PortfolioItem {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  title       String
  role        String?
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  profile TutorProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media   PortfolioMedia[]
  skills  PortfolioItemSkill[]

  @@index([profileId])
  @@map("portfolio_items")
}

model PortfolioItemSkill {
  id              String   @id @default(uuid())
  portfolioItemId String   @map("portfolio_item_id")
  skillId         String   @map("skill_id")
  createdAt       DateTime @default(now()) @map("created_at")

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, skillId])
  @@index([portfolioItemId])
  @@index([skillId])
  @@map("portfolio_item_skills")
}

model PortfolioMedia {
  id              String             @id @default(uuid())
  portfolioItemId String             @map("portfolio_item_id")
  type            PortfolioMediaType
  key             String? // S3 object key, set for IMAGE / VIDEO_FILE
  url             String? // external URL, set for VIDEO_LINK / LINK
  position        Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at")

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@index([portfolioItemId])
  @@map("portfolio_media")
}

model Certification {
  id            String    @id @default(uuid())
  profileId     String    @map("profile_id")
  title         String
  issuer        String
  issuedAt      DateTime? @map("issued_at")
  expiresAt     DateTime? @map("expires_at")
  credentialUrl String?   @map("credential_url")

  profile TutorProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  files   CertificationFile[]

  @@index([profileId])
  @@map("certifications")
}

model CertificationFile {
  id              String   @id @default(uuid())
  certificationId String   @map("certification_id")
  key             String // S3 object key
  fileName        String?  @map("file_name")
  mimeType        String?  @map("mime_type")
  createdAt       DateTime @default(now()) @map("created_at")

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([certificationId])
  @@map("certification_files")
}

model LearnerProfile {
  id           String @id @default(uuid())
  userId       String @unique @map("user_id")
  availability Json?  @map("availability")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests LearnerProfileInterest[]

  @@map("learner_profiles")
}

model LearnerProfileInterest {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  specialtyId String   @map("specialty_id")
  createdAt   DateTime @default(now()) @map("created_at")

  profile   LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  specialty Specialty      @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([profileId, specialtyId])
  @@index([profileId])
  @@index([specialtyId])
  @@map("learner_profile_interests")
}

model Employment {
  id        String @id @default(uuid())
  profileId String @map("profile_id")

  jobTitle    String  @map("job_title")
  company     String
  description String? @db.Text

  city    String?
  country String?

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  current   Boolean   @default(false)

  profile      TutorProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificates EmploymentCertificate[]

  @@index([profileId])
  @@map("employment")
}

model EmploymentCertificate {
  id           String   @id @default(uuid())
  employmentId String   @map("employment_id")
  key          String
  fileName     String?  @map("file_name")
  createdAt    DateTime @default(now()) @map("created_at")

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@index([employmentId])
  @@map("employment_certificates")
}

model TutorAvailabilityRule {
  id      String @id @default(uuid())
  tutorId String @map("tutor_id")

  /// 0 = Sunday, 1 = Monday, ... 6 = Saturday (matches JS Date.getDay())
  dayOfWeek Int @map("day_of_week")

  /// Minutes since midnight, local to `timezone` below
  startTime Int @map("start_time")

  /// Minutes since midnight, local time. Must be > startTime
  /// (CHECK constraint — see migration note at bottom of file)
  endTime Int @map("end_time")

  /// IANA name, e.g. "Europe/Paris"
  timezone String

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tutor User @relation("TutorAvailabilityRules", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([tutorId, dayOfWeek])
  @@map("tutor_availability_rules")
}

enum ExceptionType {
  BLOCKED
  ADDED

  @@map("exception_type")
}

model TutorAvailabilityException {
  id      String        @id @default(uuid())
  tutorId String        @map("tutor_id")
  date    DateTime      @db.Date
  type    ExceptionType

  startTime Int? @map("start_time")
  endTime   Int? @map("end_time")

  reason    String?
  timezone  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tutor User @relation("TutorAvailabilityExceptions", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, date])
  @@map("tutor_availability_exceptions")
}

enum LearnRequestStatus {
  DRAFT
  OPEN
  CLOSED // hiring finished — a proposal was accepted, no longer accepting new ones
  CANCELLED // learner voluntarily cancelled before hiring
  COMPLETED // all sessions finished — set once the last session completes
  REMOVED

  @@map("learn_request_status")
}

enum LearnRequestType {
  ONE_TIME
  COURSE
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("proficiency_level")
}

model LearnRequest {
  id                 String             @id @default(uuid())
  learnerId          String             @map("learner_id")
  status             LearnRequestStatus @default(DRAFT) @map("status")
  type               LearnRequestType?
  level              ProficiencyLevel?  @map("level")
  title              String
  categoryId         String?            @map("category_id")
  description        String?            @db.Text
  preferredLanguages String[]           @default([]) @map("preferred_languages")
  requestedFrequency Int?               @map("requested_frequency")
  budgetMin          Decimal?           @map("budget_min") @db.Decimal(10, 2)
  budgetMax          Decimal?           @map("budget_max") @db.Decimal(10, 2)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  learner   User                @relation("LearnerLearnRequests", fields: [learnerId], references: [id], onDelete: Cascade)
  proposals Proposal[]
  category  Category?           @relation("CategoryLearnRequests", fields: [categoryId], references: [id], onDelete: SetNull)
  skills    LearnRequestSkill[]
  savedBy   SavedLearnRequest[]

  @@index([learnerId])
  @@index([type])
  @@index([status])
  @@map("learn_requests")
}

model SavedLearnRequest {
  id             String   @id @default(uuid())
  tutorId        String   @map("tutor_id")
  learnRequestId String   @map("learn_request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  tutor        User         @relation("TutorSavedLearnRequests", fields: [tutorId], references: [id], onDelete: Cascade)
  learnRequest LearnRequest @relation(fields: [learnRequestId], references: [id], onDelete: Cascade)

  @@unique([tutorId, learnRequestId])
  @@index([tutorId])
  @@index([learnRequestId])
  @@map("saved_learn_requests")
}

model LearnRequestSkill {
  id             String   @id @default(uuid())
  learnRequestId String   @map("learn_request_id")
  skillId        String   @map("skill_id")
  createdAt      DateTime @default(now()) @map("created_at")

  learnRequest LearnRequest @relation(fields: [learnRequestId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([learnRequestId, skillId])
  @@index([learnRequestId])
  @@index([skillId])
  @@map("learn_request_skills")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN

  @@map("proposal_status")
}

enum PayoutMethod {
  PER_SESSION
  ON_COMPLETION

  @@map("payout_method")
}

model Proposal {
  id             String @id @default(uuid())
  learnRequestId String @map("learn_request_id")
  tutorId        String @map("tutor_id")

  status                 ProposalStatus @default(PENDING)
  sessionDurationMinutes Int            @map("session_duration_minutes")
  totalPrice             Decimal        @map("total_price") @db.Decimal(10, 2)
  payoutMethod           PayoutMethod   @default(ON_COMPLETION) @map("payout_method")

  message String? @db.Text

  learnerViewedAt DateTime? @map("viewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  learnRequest  LearnRequest          @relation(fields: [learnRequestId], references: [id], onDelete: Cascade)
  tutor         User                  @relation("TutorProposals", fields: [tutorId], references: [id], onDelete: Cascade)
  sessionPlans  ProposalSession[] // the pitch -- exists only while PENDING
  sessions      Session[] // the real thing -- exists only once ACCEPTED
  shortlistedBy ShortlistedProposal[]

  @@index([tutorId])
  @@index([status])
  @@index([learnRequestId, status])
  @@map("proposals")
}

model ShortlistedProposal {
  id         String   @id @default(uuid())
  learnerId  String   @map("learner_id")
  proposalId String   @map("proposal_id")
  createdAt  DateTime @default(now()) @map("created_at")

  learner  User     @relation("LearnerShortlistedProposals", fields: [learnerId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([learnerId, proposalId])
  @@index([learnerId])
  @@index([proposalId])
  @@map("shortlisted_proposals")
}

model ProposalSession {
  id            String  @id @default(uuid())
  proposalId    String  @map("proposal_id")
  sessionNumber Int     @map("session_number")
  title         String
  objective     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, sessionNumber])
  @@index([proposalId])
  @@map("proposal_sessions")
}

enum SessionStatus {
  LOCKED // previous session not yet completed — cannot be scheduled
  PENDING_SCHEDULE // unlocked, learner can pick a time
  HELD // has an ACTIVE SlotHold
  BOOKED // converted to a CONFIRMED Booking
  COMPLETED // session happened (mirrors Booking.status = COMPLETED)
  CANCELLED

  @@map("session_status")
}

model Session {
  id              String        @id @default(uuid())
  proposalId      String        @map("proposal_id")
  sessionNumber   Int           @map("session_number")
  title           String
  objective       String?       @db.Text
  status          SessionStatus @default(LOCKED)
  zoomMeetingId   String?       @map("zoom_meeting_id")
  zoomJoinUrl     String?       @map("zoom_join_url")
  zoomStartUrl    String?       @map("zoom_start_url")
  zoomPassword    String?       @map("zoom_password")
  tutorJoinedAt   DateTime?     @map("tutor_joined_at")
  learnerJoinedAt DateTime?     @map("learner_joined_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proposal      Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  slotHold      SlotHold?
  booking       Booking?
  announcements Announcement[]
  assignment    Assignment?

  @@unique([proposalId, sessionNumber])
  @@index([proposalId])
  @@index([proposalId, status])
  @@map("sessions")
}

model Announcement {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  authorId  String   @map("author_id") // tutor OR learner
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  session     Session                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author      User                     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments    AnnouncementComment[]
  attachments AnnouncementAttachment[]

  @@index([sessionId])
  @@map("announcements")
}

model AnnouncementComment {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  authorId       String   @map("author_id")
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation("AnnouncementCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("announcement_comments")
}

model AnnouncementAttachment {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  key            String
  fileName       String   @map("file_name")
  mimeType       String?  @map("mime_type")
  fileSize       Int?     @map("file_size")
  createdAt      DateTime @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("announcement_attachments")
}

enum SubmissionStatus {
  ASSIGNED // default -- nothing submitted yet
  SUBMITTED
  EXCUSED

  @@map("submission_status")
}

model Assignment {
  id           String    @id @default(uuid())
  sessionId    String    @unique @map("session_id") // @unique enforces
  // "at most one assignment per session" at the database level, not
  // just as an app-level convention
  title        String
  instructions String?   @db.Text
  dueAt        DateTime? @map("due_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  session     Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submission  AssignmentSubmission?
  comments    AssignmentComment[]
  attachments AssignmentAttachment[] // tutor's reference materials

  @@map("assignments")
}

model AssignmentAttachment {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  key          String
  fileName     String   @map("file_name")
  mimeType     String?  @map("mime_type")
  fileSize     Int?     @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_attachments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String           @unique @map("assignment_id") // 1:1 --
  // only one learner ever possible per assignment
  status       SubmissionStatus @default(ASSIGNED)
  submittedAt  DateTime?        @map("submitted_at")

  assignment  Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  attachments SubmissionAttachment[]

  @@map("assignment_submissions")
}

model SubmissionAttachment {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  key          String
  fileName     String   @map("file_name")
  mimeType     String?  @map("mime_type")
  fileSize     Int?     @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_attachments")
}

model AssignmentComment {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  authorId     String   @map("author_id")
  content      String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  author     User       @relation("AssignmentCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_comments")
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED

  @@map("hold_status")
}

model SlotHold {
  id        String     @id @default(uuid())
  tutorId   String     @map("tutor_id")
  learnerId String     @map("learner_id")
  sessionId String     @unique @map("session_id")
  startTime DateTime   @map("start_time") @db.Timestamptz(3)
  endTime   DateTime   @map("end_time") @db.Timestamptz(3)
  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at")

  tutor   User     @relation("TutorSlotHolds", fields: [tutorId], references: [id], onDelete: Cascade)
  learner User     @relation("LearnerSlotHolds", fields: [learnerId], references: [id], onDelete: Cascade)
  session Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([tutorId, startTime, endTime])
  @@index([learnerId])
  @@index([status, expiresAt])
  @@map("slot_holds")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED

  @@map("booking_status")
}

model Booking {
  id         String        @id @default(uuid())
  tutorId    String        @map("tutor_id")
  learnerId  String        @map("learner_id")
  sessionId  String?       @unique @map("session_id")
  slotHoldId String?       @unique @map("slot_hold_id")
  startTime  DateTime      @map("start_time") @db.Timestamptz(3)
  endTime    DateTime      @map("end_time") @db.Timestamptz(3)
  status     BookingStatus @default(CONFIRMED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tutor    User      @relation("TutorBookings", fields: [tutorId], references: [id], onDelete: Cascade)
  learner  User      @relation("LearnerBookings", fields: [learnerId], references: [id], onDelete: Cascade)
  session  Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  slotHold SlotHold? @relation(fields: [slotHoldId], references: [id], onDelete: SetNull)

  @@index([tutorId, startTime, endTime])
  @@index([learnerId])
  @@map("bookings")
}

model Conversation {
  id        String  @id @default(uuid())
  tutorId   String  @map("tutor_id")
  learnerId String  @map("learner_id")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at") // bumped on new message -- drives "sort conversation list by recency"

  tutor    User      @relation("TutorConversations", fields: [tutorId], references: [id], onDelete: Cascade)
  learner  User      @relation("LearnerConversations", fields: [learnerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([tutorId, learnerId]) // exactly one continuous thread per pair
  @@index([tutorId])
  @@index([learnerId])
  @@map("conversations")
}

enum MessageStatus {
  SENT
  DELIVERED
  READ

  @@map("message_status")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  senderId       String        @map("sender_id")
  content        String        @db.Text
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now()) @map("created_at")
  readAt         DateTime?     @map("read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}
