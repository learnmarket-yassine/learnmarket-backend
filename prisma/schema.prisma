generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  TUTOR
  ADMIN
}

enum LanguageLevel {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE_OR_BILINGUAL
}

enum PortfolioMediaType {
  IMAGE
  VIDEO_FILE
  VIDEO_LINK
  LINK
}

enum ConnectsTransactionType {
  PURCHASE
  SPEND
  REFUND
  BONUS
  SIGNUP_GRANT
}

enum AnnonceStatus {
  OPEN
  CLOSED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String         @map("password")
  unverifiedEmail  String?        @map("unverified_email")
  firstname        String         @map("firstname")
  lastname         String         @map("lastname")
  avatar           String?        @map("avatar_key")
  headline         String?
  bio              String?        @db.Text
  phone            String?        @unique @map("phone")
  phoneCountryCode String?        @map("phone_country_code")
  dateOfBirth      DateTime?      @map("date_of_birth")
  country          String?
  address          String?
  city             String?
  state            String?
  postalCode       String?        @map("postal_code")
  role             UserRole       @default(LEARNER)
  isOnlineForMsg   Boolean        @default(false) @map("is_online_for_msg")
  onboardingStep   Int            @default(1) @map("onboarding_step")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  refreshTokens    RefreshToken[]
  tutorProfile     TutorProfile?
  annonces         Annonce[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  deviceId   String // identifies a device — one active session per device
  deviceName String? // display label for the sessions list ("iPhone 14")
  revoked    Boolean   @default(false)
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TutorProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  hourlyRate    Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  hoursPerWeek  String?  @map("hours_per_week")
  videoIntroUrl String?  @map("video_intro_url")
  isVerified    Boolean  @default(false) @map("is_verified")
  connects      Int      @default(0) @map("connects")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  languages ProfileLanguage[]
  education Education[]
  skills    String[]          @default([]) @map("skills")

  portfolio      PortfolioItem[]
  certifications Certification[]
  employment     Employment[]
  profileSkills  ProfileSkill[]

  proposals            Proposal[]
  connectsTransactions ConnectsTransaction[]

  @@map("tutor_profiles")
}

model ProfileLanguage {
  id        String        @id @default(uuid())
  profileId String        @map("profile_id")
  language  String
  level     LanguageLevel

  profile TutorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_languages")
}

model Education {
  id           String  @id @default(uuid())
  profileId    String  @map("profile_id")
  institution  String
  degree       String?
  fieldOfStudy String? @map("field_of_study")
  startYear    Int?    @map("start_year")
  endYear      Int?    @map("end_year")

  profile TutorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("education")
}

model ProfileSkill {
  id        String @id @default(uuid())
  profileId String @map("profile_id")
  label     String

  profile TutorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("profile_skills")
}

model PortfolioItem {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  title       String
  role        String?
  description String?  @db.Text
  skills      String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")

  profile TutorProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  media   PortfolioMedia[]

  @@index([profileId])
  @@map("portfolio_items")
}

model PortfolioMedia {
  id              String             @id @default(uuid())
  portfolioItemId String             @map("portfolio_item_id")
  type            PortfolioMediaType
  key             String? // S3 object key, set for IMAGE / VIDEO_FILE
  url             String? // external URL, set for VIDEO_LINK / LINK
  position        Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at")

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@index([portfolioItemId])
  @@map("portfolio_media")
}

model Certification {
  id            String    @id @default(uuid())
  profileId     String    @map("profile_id")
  title         String
  issuer        String
  issuedAt      DateTime? @map("issued_at")
  expiresAt     DateTime? @map("expires_at")
  credentialUrl String?   @map("credential_url")

  profile TutorProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  files   CertificationFile[]

  @@index([profileId])
  @@map("certifications")
}

model CertificationFile {
  id              String   @id @default(uuid())
  certificationId String   @map("certification_id")
  key             String // S3 object key
  fileName        String?  @map("file_name")
  mimeType        String?  @map("mime_type")
  createdAt       DateTime @default(now()) @map("created_at")

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([certificationId])
  @@map("certification_files")
}

model Employment {
  id        String @id @default(uuid())
  profileId String @map("profile_id")

  jobTitle    String  @map("job_title")
  company     String
  description String? @db.Text

  city    String?
  country String?

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  current   Boolean   @default(false)

  profile      TutorProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificates EmploymentCertificate[]

  @@index([profileId])
  @@map("employment")
}

model EmploymentCertificate {
  id           String   @id @default(uuid())
  employmentId String   @map("employment_id")
  key          String
  fileName     String?  @map("file_name")
  createdAt    DateTime @default(now()) @map("created_at")

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@index([employmentId])
  @@map("employment_certificates")
}

model Annonce {
  id           String        @id @default(uuid())
  learnerId    String        @map("learner_id")
  title        String
  description  String?       @db.Text
  status       AnnonceStatus @default(OPEN)
  proposalCost Int           @default(2) @map("proposal_cost")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  learner   User       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  proposals Proposal[]

  @@index([learnerId])
  @@map("annonces")
}

model Proposal {
  id        String         @id @default(uuid())
  annonceId String         @map("annonce_id")
  tutorId   String         @map("tutor_id")
  message   String?        @db.Text
  status    ProposalStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  annonce              Annonce               @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  tutor                TutorProfile          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  connectsTransactions ConnectsTransaction[]

  @@unique([annonceId, tutorId])
  @@index([annonceId])
  @@index([tutorId])
  @@map("proposals")
}

model ConnectsPackage {
  id            String  @id @default(uuid())
  name          String
  amount        Int // connects granted on purchase
  priceCents    Int     @map("price_cents")
  currency      String  @default("usd")
  isActive      Boolean @default(true) @map("is_active")
  stripePriceId String? @map("stripe_price_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions ConnectsTransaction[]

  @@map("connects_packages")
}

model ConnectsTransaction {
  id           String                  @id @default(uuid())
  tutorId      String                  @map("tutor_id")
  type         ConnectsTransactionType
  amount       Int
  balanceAfter Int                     @map("balance_after")

  relatedProposalId     String? @map("related_proposal_id")
  relatedPackageId      String? @map("related_package_id")
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")

  createdAt DateTime @default(now()) @map("created_at")

  tutor           TutorProfile     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  relatedProposal Proposal?        @relation(fields: [relatedProposalId], references: [id], onDelete: SetNull)
  relatedPackage  ConnectsPackage? @relation(fields: [relatedPackageId], references: [id], onDelete: SetNull)

  @@index([tutorId])
  @@index([relatedProposalId])
  @@map("connects_transactions")
}
